function FireMain(...)
    local ev = _ReplicatedStorage:FindFirstChild('MainEvent')
    if ev then
        pcall(ev.FireServer, ev, ...)
    else
        local args = {...}
        local action = args[1]
        if action == 'Grabbing' then
            local val = args[2]
            if val == true then
                -- grab: handled by ClientsideGrab in Activate tool
            else
                -- release
                ClientsideRelease()
            end
        end
    end
end

