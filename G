local function MakeTool(name)
    for _, loc in ipairs({LP.Backpack, LP.Character}) do
        local old = loc and loc:FindFirstChild(name)
        if old then old:Destroy() end
    end
    task.wait(0.1)
    local t = Instance.new('Tool')
    t.RequiresHandle = false; t.Name = name; t.Parent = LP.Backpack
    return t
end

