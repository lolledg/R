local function HasNativeGrab()
    local char = LP.Character
    if not char then return false end
    local be = char:FindFirstChild('BodyEffects')
    return be and be:FindFirstChild('Grabbed') ~= nil
end

local function HasMainEvent()
    return _ReplicatedStorage:FindFirstChild('MainEvent') ~= nil
end

local function EnsureGrabbedValue()
    local char = LP.Character
    if not char then return end
    if not char:FindFirstChild('BodyEffects') then
        local be = Instance.new('Folder'); be.Name = 'BodyEffects'; be.Parent = char
    end
    local be = char.BodyEffects
    if not be:FindFirstChild('Grabbed') then
        local v = Instance.new('ObjectValue'); v.Name = 'Grabbed'; v.Parent = be
    end
end

local function FindNearestPlayer(maxDist)
    maxDist = maxDist or 20
    local myHRP = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
    if not myHRP then return nil end
    local best, bestDist = nil, maxDist
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild('HumanoidRootPart') then
            local d = (p.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
            if d < bestDist then bestDist = d; best = p.Character end
        end
    end
    return best
end

local function ClientsideGrab(targetChar)
    if not targetChar then return false end
    local char = LP.Character
    if not char then return false end
    isClientside = true
    csVictim = targetChar
    EnsureGrabbedValue()
    char.BodyEffects.Grabbed.Value = targetChar
    u19 = targetChar
    -- disable ragdoll on victim clientside
    for _, v in pairs(targetChar:GetDescendants()) do
        if v:IsA('BallSocketConstraint') or v:IsA('HingeConstraint') or v:IsA('RopeConstraint') then
            pcall(function() v.Enabled = false end)
        end
        if v:IsA('BasePart') then v.CanCollide = false end
    end
    -- lock victim in place with a loop
    if csConn then csConn:Disconnect() end
    csConn = RunService.Heartbeat:Connect(function()
        if not csVictim or not csVictim.Parent then
            csConn:Disconnect(); return
        end
        local myHRP = char:FindFirstChild('HumanoidRootPart')
        local vHRP = targetChar:FindFirstChild('HumanoidRootPart')
        if myHRP and vHRP then
            ZeroVelocity___(vHRP)
        end
    end)
    return true
end

local function ClientsideRelease()
    if not isClientside then return end
    isClientside = false
    if csConn then csConn:Disconnect(); csConn = nil end
    local char = LP.Character
    if char then
        EnsureGrabbedValue()
        char.BodyEffects.Grabbed.Value = nil
    end
    if csVictim then
        for _, v in pairs(csVictim:GetDescendants()) do
            if v:IsA('BallSocketConstraint') or v:IsA('HingeConstraint') then
                pcall(function() v.Enabled = true end)
            end
        end
    end
    csVictim = nil
end

